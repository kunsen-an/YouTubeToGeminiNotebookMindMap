{
  "manifest_version": 3,
  "name": "YouTube to Gemini Notebook Mind Map",
  "version": "0.2.21",
  "description": "YouTube videos can be added to a channel notebook in Gemini Notebook and used to generate a Studio mind map.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Gemini Notebookに追加",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "windows",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "content/notebooklm.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
